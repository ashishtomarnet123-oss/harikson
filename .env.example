# Xarwiz Cloud Environment Variables Template

# Node Environment
NODE_ENV=development
PORT=3000

# Databases
DATABASE_URL="postgresql://neuravolt:neuravolt_dev_pwd@localhost:5432/neuravolt?schema=public"
REDIS_URL="redis://localhost:6379"

# Authentication & Encryption Secrets
JWT_SECRET= # REQUIRED: Secure signing key (min 32 characters, no default)
TENANT_MASTER_KEY= # REQUIRED: Master document encryption key (min 32 characters, generate with openssl rand -base64 32)
PAYMENT_ENCRYPTION_KEY= # REQUIRED: Merchant credentials encryption key (min 32 characters)
NEXTAUTH_SECRET= # REQUIRED: Session encryption secret (no default)
ALLOWED_ORIGINS= # REQUIRED: Comma-separated list of allowed CORS origins (no default)

NEXTAUTH_URL="http://localhost:3001" # User Portal URL (app)
NEXTAUTH_ADMIN_URL="http://localhost:3002" # Admin Portal URL

# Web APIs & Gateways
NEXT_PUBLIC_API_URL="http://localhost:3000"
# Email Infrastructure & SMTP Configuration
EMAIL_ENCRYPTION_KEY= # REQUIRED: Canonical AES-256-GCM email encryption key (64-character hex string generated via openssl rand -hex 32)
SMTP_HOST="mail.xarwiz.com" # SMTP server hostname
SMTP_PORT=587 # SMTP port (587 for STARTTLS, 465 for SSL/TLS, 25 for plain)
SMTP_USER="noreply@xarwiz.com" # SMTP authentication username
SMTP_PASS= # SMTP authentication password
SMTP_SECURE="false" # "true" for port 465 SSL, "false" for port 587 STARTTLS
FROM_EMAIL="noreply@xarwiz.com" # Default sender address
FROM_NAME="Xarwiz AI" # Default sender display name
RESEND_API_KEY= # Resend API Key (alternative provider)
RESEND_WEBHOOK_SECRET= # Resend webhook signing secret for delivery tracking

# Frontend Origins
USER_PORTAL_URL="http://localhost:3000" # User portal frontend URL for password reset & verify links
ADMIN_PANEL_URL="http://localhost:3001" # Admin panel frontend URL

STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET_FILE="./secrets/stripe_webhook_secret"
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="razorpay_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="razorpay_webhook_secret_placeholder" # set on Razorpay Dashboard > Webhooks when creating the endpoint
PHONEPE_MERCHANT_ID="PGTESTPAYUAT" # PhonePe Merchant ID (MID)
PHONEPE_SALT_KEY="099eb0cd-02cf-4e2a-8aca-3e6c6aff0399" # PhonePe Salt Key
PHONEPE_SALT_INDEX="1" # Salt Index
PHONEPE_WEBHOOK_SECRET="099eb0cd-02cf-4e2a-8aca-3e6c6aff0399" # PhonePe S2S Webhook Secret
PHONEPE_ENV="sandbox" # "sandbox" or "production"
CASHFREE_PARTNER_API_KEY="cfsk_ma_test_placeholder" # Cashfree Partner API Key
CASHFREE_PARTNER_MERCHANT_ID="CF_MERCHANT_PLACEHOLDER" # Cashfree Partner Merchant ID (MID)
CASHFREE_APP_ID="cf_app_test_placeholder" # Direct Merchant App ID (optional fallback)
CASHFREE_SECRET_KEY="cf_secret_test_placeholder" # Direct Merchant Secret Key (optional fallback)
CASHFREE_WEBHOOK_SECRET="cf_webhook_secret_placeholder" # Webhook signing secret
CASHFREE_TEST_MODE="true" # "true" for sandbox, "false" for production
GOOGLE_CLIENT_ID="google_oauth_client_id_placeholder.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="google_oauth_client_secret_placeholder"
GOOGLE_REDIRECT_URI="http://localhost:3008/api/v1/user/integrations/google/callback"
GOOGLE_DRIVE_SCOPES="https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/userinfo.profile"
