NEXT_PUBLIC_API_BASE_URL=https://xarwiz.com
# Same value, different name: api-config.ts reads NEXT_PUBLIC_API_BASE_URL,
# but chat.js/login.js/several other pages independently read
# NEXT_PUBLIC_API_URL — neither the CD build steps nor this file used to
# set that second name at all, so those pages always built with an empty
# value and silently fell through to hardcoded localhost fallbacks.
# Note: as of the same-origin-proxy fix in lib/api-config.ts and every page
# that duplicated its logic, this value is now only a last-resort fallback
# (SSR / truly local dev) — real browser access always prefers the relative
# same-origin path regardless of what this is set to, so a future domain
# migration should no longer require updating this value at all.
NEXT_PUBLIC_API_URL=https://xarwiz.com
NEXT_PUBLIC_ADMIN_PANEL_URL=https://admin.neuravolt.cloud
