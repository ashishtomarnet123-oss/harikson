{
  "name": "harikson-vscode-extension",
  "displayName": "Harikson AI Code Assistant",
  "description": "Ghost text autocompletions, sidebar developer chat, and code review reviews for Harikson Multi-Tenant Platform.",
  "version": "1.0.0",
  "publisher": "harikson",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package"
  },
  "contributes": {
    "configuration": {
      "title": "Harikson AI",
      "properties": {
        "harikson.tenantUrl": {
          "type": "string",
          "default": "https://xarwiz.com",
          "description": "Your Xarwiz tenant API endpoint (e.g., https://xarwiz.com or http://localhost:3008 for local development)."
        },
        "harikson.apiKey": {
          "type": "string",
          "default": "",
          "description": "Personal access token from Xarwiz → Settings → Connected Apps → Xarwiz VS Code Extension → Connect."
        },
        "harikson.model": {
          "type": "string",
          "default": "harikson-plus",
          "enum": [
            "harikson-plus",
            "harikson-max"
          ],
          "description": "The active Harikson AI assistant model to query."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harikson-sidebar",
          "title": "Harikson AI",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "harikson-sidebar": [
        {
          "type": "webview",
          "id": "harikson-chat-view",
          "name": "Harikson Developer Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "harikson.reviewSelection",
        "title": "Harikson: Review Selection"
      },
      {
        "command": "harikson.switchModel",
        "title": "Harikson: Switch Model"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.32.0",
    "typescript": "^5.4.5"
  }
}
